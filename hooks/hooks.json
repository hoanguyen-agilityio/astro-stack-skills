{
  "description": "After a turn that changed files: a checklist of changed files and gates, plus a success signal",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/task-checklist.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
