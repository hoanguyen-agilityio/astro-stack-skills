{
  "name": "astro-stack-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Installer for the web-dev-stack Claude Code skills (Astro + React islands + TypeScript + Effect + oRPC + shadcn/ui).",
  "type": "module",
  "bin": {
    "astro-stack-skills": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "hooks/",
    "!hooks/__test__/",
    "!bin/__test__/",
    ".claude-plugin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-plugin.mjs",
    "test": "node --test \"__test__/*.test.mjs\" \"hooks/__test__/*.test.mjs\" \"bin/__test__/*.test.mjs\"",
    "validate": "claude plugin validate ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10"
  }
}
